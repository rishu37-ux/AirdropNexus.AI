# =============================================================================
# AirdropNexus AI — Environment Variables (PLACEHOLDERS ONLY)
# Never commit real secrets. Copy to .env and fill in your own values.
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=AirdropNexus AI

# Session / Security
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_strong_random_secret

# Demo login: enabled by default only in development; set true to opt in explicitly.
# Keep false in production unless you intentionally expose demo access.
ENABLE_DEMO_LOGIN=false

# Master encryption key for encrypting provider secrets at rest
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=change_this_to_a_32_byte_hex_master_key

# Database (SQLite default; abstracted for PostgreSQL later)
DB_PATH=./data/airdropnexus.sqlite
DB_DIALECT=sqlite

# X (Twitter) OAuth 2.0 — official API only
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_CALLBACK_URL=http://localhost:3000/api/auth/x/callback
X_SCOPES=tweet.read,users.read,offline.access

# AI Providers — optional. Leave blank to use rule-based fallback.
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# OpenAI-compatible custom endpoint
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=

# Ollama (local AI) — runs only when owner's machine is online
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# SMTP (optional email delivery for daily reports)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@localhost
SMTP_TO=you@example.com

# Worker / Scheduler
WORKER_MODE=local   # local | cloud
WORKER_INTERVAL_MINUTES=60
ENABLE_BACKGROUND_WORKER=true

# Timezone
TZ=Asia/Kolkata
