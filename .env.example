NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:password@localhost:5432/airdropnexus
SESSION_SECRET=replace_with_32_plus_random_characters
COOKIE_SECURE=false
# X API OAuth 2.0 (configure in X Developer Portal; callback must match APP_URL)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:3000/api/x/callback
# X OAuth scopes: users.read tweet.read tweet.write offline.access
